    "\n",
    "    stds = X.std()\n",
    "    X = X.drop(columns=stds[stds == 0].index.tolist())\n",
    "\n",
    "    num_rows = X.shape[0]\n",
    "    sparse_cols = [c for c in X.columns if (X[c] == 0).sum() / num_rows >= 0.99]\n",
    "    X = X.drop(columns=sparse_cols)\n",
