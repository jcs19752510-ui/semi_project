*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# 가상 환경
# ============================================
venv/
env/
ENV/
.venv
pip-log.txt
pip-delete-this-directory.txt

# ============================================
# IDE 및 편집기 파일
# ============================================
# VSCode
.vscode/
*.code-workspace

# PyCharm
.idea/
*.iml
*.iws
*.ipr

# Sublime Text
*.sublime-project
*.sublime-workspace

# VS
.vs/

# Jupyter Notebook
.ipynb_checkpoints/
*.ipynb_checkpoints

# ============================================
# OS 파일
# ============================================
.DS_Store
Thumbs.db
.Spotlight-V100
.Trashes

