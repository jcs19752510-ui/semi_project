# 이 파일을 복사해 .env로 사용한다. .env는 git에 커밋하지 않는다.

# --- PostgreSQL (docker-compose.yml과 동일한 값이어야 함) ---
POSTGRES_USER=semi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=semi
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# 로컬에 이미 다른 Postgres(예: toyo-db)가 5432를 점유 중이면 5555 등으로 바꾸고
# 아래 DATABASE_URL의 포트도 함께 바꿀 것

# SQLAlchemy 접속 URL (psycopg 3세대 드라이버)
DATABASE_URL=postgresql+psycopg://semi:change-me@localhost:5432/semi

# --- 개인정보 컬럼 암호화(cryptography Fernet) ---
# parents_no_hp_enc / ban_hp_enc / teacher_hp_no_enc 3개 컬럼에 사용.
# 절대 코드에 하드코딩하지 말 것. 아래 명령으로 발급:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- 세션 토큰 ---
# secrets.token_hex(32)로 발급되는 토큰의 쿠키명/만료(초)
SESSION_COOKIE_NAME=semi_session
SESSION_TTL_SECONDS=3600

# --- 산탄데르 데이터 탐색 대시보드(app/domains/dataviz) ---
# semi-backend/ 기준 상대경로. 캐글 원본 CSV(76020행 x 371열)를 그대로 읽는다.
SANTANDER_CSV_PATH=../santander-customer-satisfaction/train.csv

# --- 신용카드 사기검출 대시보드(업무명=02.신용카드) ---
# semi-backend/ 기준 상대경로. 원본(284,807행·144MB)은 GitHub 100MB 제한을 넘고
# .gitignore 대상이라 배포가 안 된다 — git으로 배포 가능한 계층화 표본(80,000행,
# ml.py MAX_TRAIN_ROWS와 동일 random_state=42)인 data/creditcard_sample.csv가 기본값.
# 원본 전체로 로컬 검증하고 싶으면 이 값을 ../ipynb/data/creditcard.csv로 바꿔서 쓸 것.
CREDITCARD_CSV_PATH=data/creditcard_sample.csv
